# Motion control action. command values: set_mode, set_velocity, play_dance.
string command
# Used with set_mode; values are the same as SetRobotMode.mode.
string mode
float32 vx
float32 vy
float32 vyaw
float32 duration
# Used with play_dance; valid range 350-400.
int32 fsm_id
int32 timeout_ms
---
int32 code
string message
int32 fsm_id
---
# Current stage: accepted, running, finished.
string stage
int32 fsm_id

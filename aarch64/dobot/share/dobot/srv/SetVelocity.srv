# Send a base velocity command. Motion control stops on its own after the timeout. To stop, use vx=vy=vyaw=0.
# Positive is forward, in m/s.
float32 vx
# Positive is left, in m/s.
float32 vy
# Positive is counter-clockwise, in rad/s.
float32 vyaw
# Hold duration, in s. Values below 0 are rejected by the SDK.
float32 duration
int32 timeout_ms
---
int32 code
string message

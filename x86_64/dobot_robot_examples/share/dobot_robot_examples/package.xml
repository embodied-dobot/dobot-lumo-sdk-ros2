<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>dobot_robot_examples</name>
  <version>0.2.1</version>
  <description>Dobot ROS 2 examples: subscribing, publishing commands, closed loop, and motion_service, which exposes JSON-RPC as ROS services.</description>
  <maintainer email="sdk@dobot.local">dobot</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclpy</depend>
  <depend>dobot</depend>
  <depend>dobot_robot_sdk</depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>

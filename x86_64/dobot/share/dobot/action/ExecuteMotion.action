# 运控动作。command 取值 set_mode、set_velocity、play_dance。
string command
# set_mode 时使用，取值同 SetRobotMode.mode。
string mode
float32 vx
float32 vy
float32 vyaw
float32 duration
# play_dance 时使用，合法范围 350–400。
int32 fsm_id
int32 timeout_ms
---
int32 code
string message
int32 fsm_id
---
# 当前阶段：accepted、running、finished。
string stage
int32 fsm_id

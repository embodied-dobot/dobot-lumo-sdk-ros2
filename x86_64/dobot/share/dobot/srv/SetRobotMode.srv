# Switch the motion control mode. mode values: zero_torque damping custom_debug ready standing walking.
# Corresponding FSM ids: 0 / 1 / 2 / 100 / 300 / 304.
string mode
# Timeout of this call, in ms, range 1-60000.
int32 timeout_ms
---
# 0 on success. For non-zero values see the dobot_robot_sdk error codes.
int32 code
string message
# FSM id that was sent. -1 on failure.
int32 fsm_id

# Play a preset action. Corresponds to C++ AutoEnterBox, AutoExitBox, LieDown, GoProne, StandUpFromSupine, StandUpFromProne.
# action values and FSM ids:
#   auto_enter_box 307   autonomous box entry; enters damping (1) when done
#   auto_exit_box 308    autonomous box exit; enters humanoid walking (304) first, then standing (300) after about 2 s
#   lie_down 310         lie down; enters damping (1) when done
#   stand_up_supine 311  stand up from supine; same ending as auto_exit_box
#   go_prone 312         go prone; enters damping (1) when done
#   stand_up_prone 313   stand up from prone; same ending as auto_exit_box
# Success only means the switch was accepted, not that the action has finished. Do not switch to standing immediately after actions such as auto_exit_box return.
string action
int32 timeout_ms
---
int32 code
string message
# FSM id that was sent. -1 on failure.
int32 fsm_id

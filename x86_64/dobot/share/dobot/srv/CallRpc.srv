# Call a JSON-RPC method on the robot directly. Corresponds to C++ MotionRpc::Call.
# For methods that have no dedicated service yet. The caller is responsible for the safety of methods that change robot state.
string method
# JSON object text, e.g. "{}" or "{\"fsm_id\":300}".
string params_json
int32 timeout_ms
---
# 0 means the transport succeeded and the response contains a result. The caller interprets the meaning of the result per method.
int32 code
string message
# Raw JSON text returned by the robot.
string response_json

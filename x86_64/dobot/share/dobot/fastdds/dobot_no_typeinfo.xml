<?xml version="1.0" encoding="UTF-8" ?>
<!--
  Default Fast DDS participant profile loaded by the dobot package. hooks/dobot_fastdds.dsv points
  rmw_fastrtps_cpp to it through FASTDDS_DEFAULT_PROFILES_FILE when the package is sourced.

  Disables XTypes type information propagation. When left enabled, a ROS subscriber (whose type is generated
  from msg via rosidl) discovers the topic, but the robot-side writer does not match it and echo shows no data.
  Fast DDS programs generated directly from the firmware IDL are not affected.
  Trade-off: the two ends no longer check type consistency during discovery. If the firmware IDL changes and
  this package falls behind, no mismatch is reported and wrong data may be decoded. Update msg whenever the IDL changes.
-->
<dds xmlns="http://www.eprosima.com">
  <profiles>
    <participant profile_name="dobot_no_typeinfo" is_default_profile="true">
      <rtps>
        <propertiesPolicy>
          <properties>
            <property>
              <name>fastdds.type_propagation</name>
              <value>disabled</value>
            </property>
          </properties>
        </propertiesPolicy>
      </rtps>
    </participant>
  </profiles>
</dds>
